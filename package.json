{
  "name": "desafio-vlab",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev:backend": "pnpm --filter backend dev",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "preview:frontend": "pnpm --filter frontend preview",
    "test": "pnpm test:backend",
    "test:all": "pnpm test:backend && pnpm test:frontend",
    "test:backend": "pnpm --filter backend test",
    "test:component": "pnpm --filter frontend test:component",
    "test:frontend": "pnpm test:component && pnpm test:visual",
    "test:visual": "pnpm --filter frontend test:visual",
    "build:backend": "pnpm --filter backend build",
    "prisma:generate": "pnpm --filter backend prisma:generate",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  }
}
